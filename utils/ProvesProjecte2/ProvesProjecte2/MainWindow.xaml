<Window x:Class="ProvesProjecte2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProvesProjecte2"
        mc:Ignorable="d"
        Title="Pixel Art Converter" Height="600" Width="800">
    <Grid Background="#333">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="White">

            <Button Content="Importar" Click="BtnImportar_Click" Margin="5" Padding="5"/>

            <TextBlock Text="Tamaño:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <Button Content="-" Click="BtnMenos_Click" Width="25" Margin="0,5"/>
            <TextBox Name="TxtPixelSize" Text="10" Width="40" 
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Margin="2,5" IsReadOnly="True" FontWeight="Bold"/>
            <Button Content="+" Click="BtnMas_Click" Width="25" Margin="0,5"/>
            <CheckBox Name="CheckPalette" Content="Reducir Colores" 
                      VerticalAlignment="Center" Margin="15,0" IsChecked="True"/>

            <Button Content="Pixelar" Click="BtnPixelar_Click" Margin="10,5" Padding="15,5" Background="LightBlue" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="20" BorderBrush="Gray" BorderThickness="1" Background="#222">
            <Image Name="PixelArtDisplay" 
                   RenderOptions.BitmapScalingMode="NearestNeighbor" 
                   Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>