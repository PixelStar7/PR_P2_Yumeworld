<Page x:Class="YumeEditor.Pages.PageAct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YumeEditor.Pages"
      mc:Ignorable="d" 
      Background="AliceBlue"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageAct">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Editor d'Accions (Actions)" FontSize="20" FontWeight="Bold" Foreground="#444"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" >
                <Label Content="Nom de l'acció"/>
                <TextBox x:Name="txtNom" Margin="0,5,0,15"/>

                <Label Content="Tipus de efecte"/>
                <ComboBox x:Name="cbxTipus" Margin="0,5,0,15"/>



            </StackPanel>
        </Grid>





        <Button x:Name="btnSave" Grid.Row="2" Content="Guardar Action" 
    FontSize="16" FontWeight="Bold" Height="50" Margin="0,20,0,0"
    Click="btnSave_Click" HorizontalAlignment="Right"/>
    </Grid>

</Page>
