<Page x:Class="YumeEditor.Pages.PagePersonatge"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YumeEditor.Pages"
      mc:Ignorable="d"
      Background="AliceBlue"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="PagePersonatge">

    <Page.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Tipus d'Entitat:" Margin="0,0,20,0" FontSize="16"/>
                <RadioButton x:Name="rbPlayer" Content="Jugador (Player)" GroupName="Type" IsChecked="True" VerticalAlignment="Center" FontSize="16" Margin="0,0,20,0" Click="rbType_Click"/>
                <RadioButton x:Name="rbEnemy" Content="Enemic (Enemy)" GroupName="Type" VerticalAlignment="Center" FontSize="16" Click="rbType_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border BorderBrush="#DDD" BorderThickness="2" CornerRadius="5" Width="150" Height="150" Background="White">
                        <Image x:Name="imgYumedant" Stretch="UniformToFill"/>
                    </Border>
                    <Button x:Name="btnUpload" Content="Pujar Imatge" Margin="0,10,0,0" Padding="15,5"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Label Content="Nom del Personatge"/>
                    <TextBox x:Name="txtNom" Margin="0,5,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Label Content="Nivell Inicial"/>
                            <TextBox x:Name="txtLevel"/>
                        </StackPanel>
                    </Grid>

                    <Label Content="Descripció" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtDesc" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Estadístiques Base" Padding="10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <Label Content="HP (Vida)"/>
                            <TextBox x:Name="txtHP"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <Label Content="MP (Màgia)"/>
                            <TextBox x:Name="txtMP"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <Label Content="ATK (Atac)"/>
                            <TextBox x:Name="txtAtk"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <Label Content="DEF (Defensa)"/>
                            <TextBox x:Name="txtDef"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="pnlPlayerConfig" Grid.Row="1" Header="Configuració de Jugador" BorderBrush="#4CAF50" Visibility="Visible">
                    <StackPanel Margin="10">
                        <Label Content="Rol / Classe"/>
                        <ComboBox x:Name="cbRole" Height="30" Margin="0,5,0,15"/>

                        <Label Content="Experiència Actual"/>
                        <TextBox x:Name="txtPlayerExp" Text="0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="pnlEnemyConfig" Grid.Row="1" Header="Configuració d'Enemic" BorderBrush="#F44336" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Label Content="Experiència que dona (Given Exp)"/>
                            <TextBox x:Name="txtGivenExp"/>
                        </StackPanel>

                        <GroupBox Grid.Row="1" Header="Botí (Drops)">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbItem" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txtPercentatge" Grid.Column="1" Text="10%" ToolTip="Probabilitat"/>
                                    <Button x:Name="btnAddItem" Grid.Column="2" Content="+" Width="30" Margin="5,0,0,0"/>
                                </Grid>

                                <ListBox x:Name="lsbItemsDrop" Grid.Row="1"/>
                                <Button x:Name="btnRemoveItem" Grid.Row="1" Content="-" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="30" Margin="0,0,20,10"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </GroupBox>

            </Grid>
        </Grid>

        <Button x:Name="btnSaveYumedant" Grid.Row="2" Content="GUARDAR YUMEDANT" 
                FontSize="16" FontWeight="Bold" Height="50" Margin="0,20,0,0"
                Click="btnSaveYumedant_Click" HorizontalAlignment="Right"/>
    </Grid>
</Page>
