<Page x:Class="YumeEditor.Pages.PageBiome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:YumeEditor.Pages"
      mc:Ignorable="d"
      Background="{StaticResource BackgroundBrush}"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="PageBiome">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Editor de Biomes 🌲" FontSize="20" FontWeight="Bold" Foreground="#444"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <GroupBox Header="Informació General" Padding="10" Margin="0,0,0,20" BorderBrush="#2196F3">
                    <StackPanel>
                        <Label Content="Nom del Bioma"/>
                        <TextBox x:Name="txtNom" Margin="0,5,0,15"/>

                        <Label Content="Ordre (com es distribueix per pisos al servidor)"/>
                        <TextBox x:Name="txtOrdre" Margin="0,5,0,0" Width="100" HorizontalAlignment="Left"/>
                        <TextBlock Text="0 = primer bioma (més suau), valors més alts = més avançat."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,5,0,15"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Configuració Visual" Padding="10" Margin="0,0,0,20" BorderBrush="#2196F3">
                    <StackPanel>
                        <TextBlock Text="Enganxa la ruta de la imatge de fons que es veurà durant el combat o exploració."
                                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,15" FontSize="12"/>

                        <TextBox x:Name="txtBackgroundUrl" Margin="0,0,0,10" Height="40" VerticalContentAlignment="Center"/>

                        <Button x:Name="btnPreviewImg" Content="Previsualitzar Imatge"
                                Height="40" Click="btnPreviewImg_Click"
                                Cursor="Hand" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Enemics al Bioma" Padding="10" BorderBrush="#2196F3">
                    <StackPanel>
                        <TextBlock Text="Quins enemics apareixen en aquest bioma i quants en surten."
                                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10" FontSize="12"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="cbEnemy" Grid.Column="0" Margin="0,0,5,0" Height="28"/>
                            <TextBox x:Name="txtQuantitat" Grid.Column="1" Margin="0,0,5,0" Height="28" Text="1" VerticalContentAlignment="Center"/>
                            <Button x:Name="btnAddEnemy" Grid.Column="2" Content="Afegir" Click="btnAddEnemy_Click"
                                    Padding="10,2" Background="#4CAF50" Foreground="White"/>
                        </Grid>

                        <ListBox x:Name="lsbEnemics" Height="120" Margin="0,5,0,5"/>

                        <Button x:Name="btnRemoveEnemy" Content="Treure seleccionat" Click="btnRemoveEnemy_Click"
                                Background="#E57373" Foreground="White" Padding="8,3" HorizontalAlignment="Right"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Previsualització del Background" Margin="0,0,0,5"/>

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#CCC" Background="#E0E0E0" CornerRadius="5" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="Sense Imatge" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999" FontSize="20" FontWeight="Bold"/>

                        <Image x:Name="imgBackground" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Button x:Name="btnSaveBiome" Grid.Row="2" Click="btnSaveBiome_Click"
                Content="GUARDAR BIOMA"
                FontSize="16" FontWeight="Bold" Height="50" Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Background="#FFB292FF" Foreground="White"/>
    </Grid>
</Page>
