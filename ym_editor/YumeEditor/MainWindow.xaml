<Window x:Class="YumeEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YumeEditor"
        mc:Ignorable="d"
        Background="AliceBlue"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="lblTitle" Grid.ColumnSpan="2" TextAlignment="Center" IsEnabled="False">YumeWorld Editor</TextBox>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5">
            <Button Margin="5" x:Name="btnYumedant" Click="btnYumedant_Click"> Yumendants</Button>
            <Button Margin="5" x:Name="btnAction" Click="btnAction_Click">Actions</Button>
            <Button Margin="5" x:Name="btnEffect" Click="btnEffect_Click">Effects</Button>
            <Button Margin="5" x:Name="btnRole" Click="btnRole_Click">Roles</Button>
            <Button Margin="5" x:Name="btnBiome" Click="btnBiome_Click">Biomes</Button>
        </StackPanel>

        <TreeView x:Name="tree_Contingut" MouseDoubleClick="tree_Contingut_MouseDoubleClick" Grid.Row="2" Grid.Column="0"></TreeView>

        <Button x:Name="btn_DeleteItem" Click="btn_DeleteItem_Click" Grid.Column="0" Grid.Row="3" Margin="10" Content="Delete Item"></Button>

        <Frame x:Name="frmMain" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
